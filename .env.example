# Copy to .env (git-ignored) on the machine that runs the server, fill in, then restart krosshair.service.
# All three come from https://discord.com/developers/applications — see README "Discord login".
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token: only needed for adding pilots to the Discord server when they log in.
DISCORD_BOT_TOKEN=
# Must match the redirect registered on the Discord application, minus /auth/discord/callback.
PUBLIC_URL=https://krosshair.online
