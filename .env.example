# Copy to .env (git-ignored) next to package.json on the machine that runs the server, then restart krosshair.service.
# Login itself needs nothing here: the application's public ID lives in src/arena/shared/constants.js.

# Bot token (Developer Portal → Bot). Lets a login add the pilot to the Krosshair Discord.
DISCORD_BOT_TOKEN=
# Discord channel webhooks (Server Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL).
# Anyone holding one of these URLs can post to that channel, so treat them like passwords.
# Updates: a warning before every deploy restart, and "update live" with the commit when it is back.
DISCORD_WEBHOOK_UPDATES=
# Leaderboard: posts when the top three of any board changes.
DISCORD_WEBHOOK_LEADERBOARD=
# Seconds of warning players get before a deploy restart (0–60). systemd kills a service after 90.
# RESTART_GRACE_SECONDS=20

# Optional: switches login to the code flow so Discord's token never reaches the browser.
DISCORD_CLIENT_SECRET=
# Optional: only if the server cannot work out its own public address.
# PUBLIC_URL=https://krosshair.online
# Guests (callsign play, nothing saved) are allowed by default. ALLOW_GUESTS=0 makes a Discord login compulsory.
# ALLOW_GUESTS=0
